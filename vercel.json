{
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/termos", "destination": "/termos.html" },
    { "source": "/fiquepordentro", "destination": "/fiquepordentro.html" },
    { "source": "/blog/admin", "destination": "/blog/admin/index.html" },
    { "source": "/blog/api/posts", "destination": "/api/blog/posts" },
    { "source": "/blog/api/posts/:slug", "destination": "/api/blog/posts?slug=:slug" },
    { "source": "/blog/api/admin/posts", "destination": "/api/blog/admin/posts" },
    { "source": "/blog/post/:slug", "destination": "/blog/post.html?slug=:slug" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/auth/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/api/contact",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    },
    {
      "source": "/api/contact/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, PATCH, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/api/blog/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/blog/data/posts.json",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ]
}
